# Email Agent - Environment Variables
# Copy to .env and fill in the values

# Database
POSTGRES_PASSWORD=changeme_secure_password_here

# Keycloak (shared instance)
KEYCLOAK_CLIENT_SECRET=changeme_keycloak_client_secret

# CSRF
CSRF_SECRET_KEY=changeme_csrf_secret_32_bytes_minimum

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Encryption (KEK - 32 bytes base64 encoded)
# Generate with: openssl rand -base64 32
KEK_BASE64=changeme_32_byte_base64_encoded_key

# Container images (CI overrides these with GHCR coordinates)
API_IMAGE=email-agent-api:latest
WEB_IMAGE=email-agent-web:latest